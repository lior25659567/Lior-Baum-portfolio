      {
        "id": "pcb-psi",
        "type": "problemSolutionImpact",
        "items": [
          {
            "label": "Problem",
            "text": "Enterprise privacy teams needed conditional logic, branding, version history and field reordering. The old editor could take each one, but every addition made it more crowded and harder to use."
          },
          {
            "label": "Solution",
            "text": "We rebuilt the builder around direct editing — click the form to change it — with a fixed properties panel, a navigation panel for structure, and theme and settings kept out of the way."
          },
          {
            "label": "Impact",
            "text": "More users finished building and customizing their forms. The same editor layout now runs other BigID builders, which cut dev effort and means users don't relearn editing in each product."
          }
        ]
      },
